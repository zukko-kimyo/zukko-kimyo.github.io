rules_version = '2';
// Zukko Kimyo — Firestore xavfsizlik qoidalari
// Firebase Console → Firestore Database → Rules bo'limiga to'liq ko'chirib, "Publish" bosing.
// MUHIM: quyidagi admin email firebase-config.js dagi loginDomain bilan bir xil bo'lsin.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function role() { return hasProfile() ? profile().role : ''; }
    function isStaff() { return role() == 'teacher' || role() == 'admin'; }
    function isAdmin() { return role() == 'admin'; }
    function isAdminEmail() { return signedIn() && request.auth.token.email == 'admin@zukko-kimyo.uz'; }
    function codeDoc(code) { return get(/databases/$(db)/documents/classes/$(code)).data; }
    // O'quvchi o'zi ro'yxatdan o'tishi: faol sinf kodi bilan, "pending" holatda
    function selfSignup(uid) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == uid
        && d.keys().hasOnly(['login', 'name', 'role', 'cls', 'status', 'code', 'created', 'self'])
        && d.role == 'student' && d.status == 'pending' && d.self == true
        && request.auth.token.email == d.login + '@zukko-kimyo.uz'
        && exists(/databases/$(db)/documents/classes/$(d.code))
        && codeDoc(d.code).active == true && codeDoc(d.code).cls == d.cls
        && regOpen();
    }
    // Administrator ro'yxatdan o'tishni yopgan bo'lsa (settings/site.regOpen == false), o'zi ro'yxatdan o'tib bo'lmaydi
    function regOpen() {
      return !exists(/databases/$(db)/documents/settings/site)
        || get(/databases/$(db)/documents/settings/site).data.get('regOpen', true) != false;
    }

    // Foydalanuvchi profillari: ism, login, sinf, rol
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if (isStaff() && request.resource.data.role == 'student')
                    || (isAdmin() && request.resource.data.role == 'teacher')
                    || (isAdminEmail() && request.auth.uid == uid && request.resource.data.role == 'admin'
                        && !exists(/databases/$(db)/documents/users/$(uid)))
                    || selfSignup(uid);
      allow update: if (isStaff() && resource.data.role == 'student' && request.resource.data.role == 'student')
                    || (isAdmin() && resource.data.role != 'admin');
      allow delete: if (isStaff() && resource.data.role == 'student') || (isAdmin() && resource.data.role == 'teacher');
    }

    // O'quvchining natijalari (XP, darslar, testlar)
    match /progress/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if hasProfile() && request.auth.uid == uid
                            && request.resource.data.role == role()
                            && profile().get('status', 'active') != 'pending';
      allow delete: if isStaff();
    }

    // Parollar: o'quvchilarnikini o'qituvchilar, o'qituvchilarnikini faqat administrator ko'radi
    match /secrets/{uid} {
      allow read: if isAdmin() || (isStaff() && resource.data.role == 'student');
      allow create, update: if isAdmin() || (isStaff() && request.resource.data.role == 'student');
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student'
                    && request.resource.data.keys().hasOnly(['pw', 'role', 'login'])
                    && exists(/databases/$(db)/documents/users/$(uid))
                    && get(/databases/$(db)/documents/users/$(uid)).data.status == 'pending';
      allow delete: if isAdmin() || (isStaff() && resource.data.role == 'student');
    }

    // Sinf kodlari: kodni bilgan odam faqat o'sha bitta kodni tekshira oladi, ro'yxatni faqat o'qituvchilar ko'radi
    match /classes/{code} {
      allow get: if true;
      allow list, create, update, delete: if isStaff();
    }

    // Sayt sozlamalari: e'lon va ro'yxatdan o'tish holati. Hamma o'qiydi (kirish oynasida kerak), faqat administrator yozadi
    match /settings/{id} {
      allow get: if id == 'site';
      allow list: if false;
      allow write: if isAdmin() && id == 'site'
                   && request.resource.data.keys().hasOnly(['announce', 'announceOn', 'regOpen', 'updated', 'by'])
                   && (!('announce' in request.resource.data) || (request.resource.data.announce is string && request.resource.data.announce.size() <= 300));
    }

    // Davomat hujjatlari: har sinf uchun har kunga bitta yozuv.
    // Faqat roli tekshirilgan maktab xodimlari o'qishi va yozishi mumkin.
    match /attendance/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['date', 'cls', 'entries', 'updated', 'by'])
        && request.resource.data.keys().hasAll(['date', 'cls', 'entries', 'updated', 'by'])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.cls is string
        && request.resource.data.cls.size() > 0
        && request.resource.data.cls.size() <= 80
        && request.resource.data.entries is map
        && request.resource.data.updated is int
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
