rules_version = '2';
// Zukko Kimyo — Firestore xavfsizlik qoidalari
// Firebase Console → Firestore Database → Rules bo'limiga to'liq ko'chirib, "Publish" bosing.
// MUHIM: quyidagi admin email firebase-config.js dagi loginDomain bilan bir xil bo'lsin.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function role() { return hasProfile() ? profile().role : ''; }
    // O'chirilgan (disabled) xodim huquqlarini yo'qotadi — mijoz tekshiruviga tayanilmaydi
    function activeProfile() { return hasProfile() && profile().get('disabled', false) != true; }
    function isStaff() { return activeProfile() && (profile().role == 'teacher' || profile().role == 'admin'); }
    function isAdmin() { return activeProfile() && profile().role == 'admin'; }
    function isAdminEmail() { return signedIn() && request.auth.token.email == 'admin@zukko-kimyo.uz'; }
    function codeDoc(code) { return get(/databases/$(db)/documents/classes/$(code)).data; }
    // Faqat "o'quvchi" profili bor uid (o'qituvchi/admin parol yozuviga o'qituvchi tega olmasin)
    function isStudentUid(uid) {
      return exists(/databases/$(db)/documents/users/$(uid))
        && get(/databases/$(db)/documents/users/$(uid)).data.role == 'student';
    }
    // Natija hujjati: faqat ma'lum maydonlar, sonlar — son, matnlar — matn (o'qituvchi paneliga kod yuborib bo'lmasin)
    function optNum(d, k, mx) { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] <= mx); }
    function optStr(d, k, mx) { return !(k in d) || (d[k] is string && d[k].size() <= mx); }
    function validProgress(d) {
      return d.keys().hasOnly(['data', 'updated', 'login', 'name', 'cls', 'role', 'xp', 'done6', 'done7', 'done8',
                               'quizAvg', 'quizN', 'labs', 'visited', 'last'])
        && optStr(d, 'data', 400000) && optNum(d, 'updated', 100000000000000)
        && optStr(d, 'login', 80) && optStr(d, 'name', 120) && optStr(d, 'cls', 40) && optStr(d, 'last', 20)
        && optNum(d, 'xp', 10000000) && optNum(d, 'done6', 500) && optNum(d, 'done7', 500) && optNum(d, 'done8', 500)
        && (!('quizAvg' in d) || d.quizAvg == null || (d.quizAvg is number && d.quizAvg >= 0 && d.quizAvg <= 10))
        && optNum(d, 'quizN', 10000) && optNum(d, 'labs', 10000) && optNum(d, 'visited', 10000);
    }
    // O'quvchi o'zi ro'yxatdan o'tishi: faol sinf kodi bilan, "pending" holatda
    function selfSignup(uid) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == uid
        && d.keys().hasOnly(['login', 'name', 'role', 'cls', 'status', 'code', 'created', 'self'])
        && d.role == 'student' && d.status == 'pending' && d.self == true
        && request.auth.token.email == d.login + '@zukko-kimyo.uz'
        && exists(/databases/$(db)/documents/classes/$(d.code))
        && codeDoc(d.code).active == true && codeDoc(d.code).cls == d.cls
        && regOpen();
    }
    // Administrator ro'yxatdan o'tishni yopgan bo'lsa (settings/site.regOpen == false), o'zi ro'yxatdan o'tib bo'lmaydi
    function regOpen() {
      return !exists(/databases/$(db)/documents/settings/site)
        || get(/databases/$(db)/documents/settings/site).data.get('regOpen', true) != false;
    }

    // Obuna (users/{uid}.sub) — faqat administrator beradi. O'qituvchi o'quvchini tahrirlaganda obunasi o'zgarmasligi shart.
    // Obuna yozuvi: { plan, until, at?, by? }
    function validSubVal(x) {
      return x == null || (x is map && x.keys().hasOnly(['plan', 'until', 'at', 'by'])
            && x.plan in ['month', 'quarter', 'year']
            && x.until is number && x.until >= 0 && x.until < 10000000000000
            && (!('at' in x) || x.at is number) && (!('by' in x) || (x.by is string && x.by.size() <= 128)));
    }
    // sub — eski (kimyo); subs — har fanga alohida; subjects — o'qituvchiga biriktirilgan fanlar
    function validSub(d) {
      return (!('sub' in d) || validSubVal(d.sub))
        && (!('subs' in d) || (d.subs is map && d.subs.keys().hasOnly(['chem', 'math', 'eng', 'rus', 'art', 'sport', 'life'])
            && validSubVal(d.subs.get('chem', null)) && validSubVal(d.subs.get('math', null))
            && validSubVal(d.subs.get('eng', null)) && validSubVal(d.subs.get('rus', null))
            && validSubVal(d.subs.get('art', null)) && validSubVal(d.subs.get('sport', null)) && validSubVal(d.subs.get('life', null))))
        && (!('subjects' in d) || (d.subjects is list && d.subjects.size() <= 7 && d.subjects.hasOnly(['chem', 'math', 'eng', 'rus', 'art', 'sport', 'life'])));
    }
    // O'qituvchi shu fanga biriktirilganmi (maydon yo'q — eski o'qituvchi, kimyo)
    function teacherOf(s) { return activeProfile() && profile().role == 'teacher' && s in profile().get('subjects', ['chem']); }

    // ---------- Darslik sahifalari (ADR-0008): content/<fan>-<sinf>-<qism>-<sahifa> ----------
    function freeN() {
      return exists(/databases/$(db)/documents/settings/site)
        ? get(/databases/$(db)/documents/settings/site).data.get('freeN', 3) : 3;
    }
    function hasSubjectSub(s) {
      let sub = profile().get('subs', {}).get(s, null);
      return sub != null && sub.until > request.time.toMillis();
    }
    function validContent(d) {
      return d.keys().hasOnly(['s', 'g', 'part', 'p', 'n', 'img', 'w', 'h', 'at', 'by'])
        && d.s in ['math', 'eng', 'rus', 'art', 'sport', 'life'] && d.g is int && d.g >= 1 && d.g <= 11
        && d.part is int && d.part >= 1 && d.part <= 10 && d.p is int && d.p >= 0 && d.p <= 400
        && d.n is int && d.n >= 0 && d.n <= 600
        && d.img is string && d.img.size() < 1000000 && d.img.matches('^data:image/(webp|jpeg);base64,.*');
    }
    match /content/{id} {
      // Bitta sahifani o'qish: admin, shu fan o'qituvchisi, bepul mavzu (dastlabki freeN) yoki shu fan obunasi faol o'quvchi.
      // Ro'yxat (list) yopiq — sahifalar faqat birma-bir olinadi.
      allow get: if activeProfile() && (isAdmin() || teacherOf(resource.data.s)
                   || (resource.data.n >= 1 && resource.data.n <= freeN()) || hasSubjectSub(resource.data.s));
      allow list: if false;
      allow create, update: if isAdmin() && validContent(request.resource.data);
      allow delete: if isAdmin();
    }
    // Dars mazmuni (1-sinf va keyingilar): lessons/<fan>-<sinf>-<qism>-<mavzu>; j — dars JSON matni. Ruxsat — darslik sahifalari bilan bir xil.
    function validLesson(d) {
      return d.keys().hasOnly(['s', 'g', 'part', 'n', 'j', 'at', 'by'])
        && d.s in ['math', 'eng', 'rus', 'art', 'sport', 'life'] && d.g is int && d.g >= 1 && d.g <= 11
        && d.part is int && d.part >= 1 && d.part <= 10 && d.n is int && d.n >= 1 && d.n <= 600
        && d.j is string && d.j.size() < 200000;
    }
    match /lessons/{id} {
      // Yo'q hujjat (dars hali yuklanmagan) — xato emas, «topilmadi» qaytadi: hech narsa oshkor qilmaydi
      allow get: if activeProfile() && (resource == null || isAdmin() || teacherOf(resource.data.s)
                   || resource.data.n <= freeN() || hasSubjectSub(resource.data.s));
      allow list: if false;
      allow create, update: if isAdmin() && validLesson(request.resource.data);
      allow delete: if isAdmin();
    }
    match /lessonIndex/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['count', 'at', 'by', 'file'])
                   && request.resource.data.count is int && request.resource.data.count <= 200;
    }
    // Qaysi darslik yuklangani (kichik hujjat): hamma kirgan foydalanuvchi o'qiydi, faqat admin yozadi
    match /contentIndex/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['pages', 'from', 'to', 'at', 'by', 'file'])
                   && request.resource.data.pages is int && request.resource.data.pages <= 400;
    }

    // Foydalanuvchi profillari: ism, login, sinf, rol
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      // O'qituvchi faqat kuzatadi (2026-11-17): o'quvchi qo'shish, o'zgartirish va o'chirish — faqat administrator
      allow create: if (isAdmin() && request.resource.data.role in ['student', 'teacher'] && validSub(request.resource.data))
                    || (isAdminEmail() && request.auth.uid == uid && request.resource.data.role == 'admin'
                        && !exists(/databases/$(db)/documents/users/$(uid)))
                    || selfSignup(uid);
      allow update: if isAdmin() && resource.data.role != 'admin' && validSub(request.resource.data);
      allow delete: if isAdmin() && resource.data.role in ['student', 'teacher'];
    }

    // O'quvchining natijalari (XP, darslar, testlar)
    match /progress/{uid} {
      // Kimyo natijalari: o'zi, admin yoki kimyo fani biriktirilgan o'qituvchi
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || teacherOf('chem'));
      allow create, update: if hasProfile() && request.auth.uid == uid
                            && request.resource.data.role == role()
                            && profile().get('status', 'active') != 'pending'
                            && profile().get('disabled', false) != true
                            && validProgress(request.resource.data);
      allow delete: if isAdmin();
    }

    // Parollar: faqat administrator (o'qituvchi faqat natijalarni kuzatadi — 2026-11-17)
    match /secrets/{uid} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'student'
                    && request.resource.data.keys().hasOnly(['pw', 'role', 'login'])
                    && exists(/databases/$(db)/documents/users/$(uid))
                    && get(/databases/$(db)/documents/users/$(uid)).data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Sinf kodlari: kodni bilgan odam faqat o'sha bitta kodni tekshira oladi, ro'yxat va boshqaruv — faqat administrator
    match /classes/{code} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Sayt sozlamalari: e'lon va ro'yxatdan o'tish holati. Hamma o'qiydi (kirish oynasida kerak), faqat administrator yozadi
    match /settings/{id} {
      allow get: if id == 'site';
      allow list: if false;
      allow write: if isAdmin() && id == 'site'
                   && request.resource.data.keys().hasOnly(['announce', 'announceOn', 'regOpen', 'updated', 'by', 'prices', 'payInfo', 'freeN'])
                   && (!('freeN' in request.resource.data) || (request.resource.data.freeN is int && request.resource.data.freeN >= 0 && request.resource.data.freeN <= 50))
                   && (!('payInfo' in request.resource.data) || (request.resource.data.payInfo is string && request.resource.data.payInfo.size() <= 400))
                   && (!('prices' in request.resource.data) || (request.resource.data.prices is map
                        && request.resource.data.prices.keys().hasOnly(['month', 'quarter', 'year'])
                        && request.resource.data.prices.get('month', '') is string && request.resource.data.prices.get('month', '').size() <= 40
                        && request.resource.data.prices.get('quarter', '') is string && request.resource.data.prices.get('quarter', '').size() <= 40
                        && request.resource.data.prices.get('year', '') is string && request.resource.data.prices.get('year', '').size() <= 40))
                   && (!('announce' in request.resource.data) || (request.resource.data.announce is string && request.resource.data.announce.size() <= 300));
    }

    // Davomat: hozircha faqat administrator (UI ham faqat admin uchun).
    match /attendance/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'cls', 'entries', 'updated', 'by'])
        && request.resource.data.keys().hasAll(['date', 'cls', 'entries', 'updated', 'by'])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.cls is string
        && request.resource.data.cls.size() > 0
        && request.resource.data.cls.size() <= 80
        && request.resource.data.entries is map
        && request.resource.data.entries.size() <= 120
        && request.resource.data.updated is int
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- O'qituvchi yuboradigan testlar (ADR-0010) ----------
    // examTests — o'qituvchining test bazasi (to'g'ri javoblar bilan), faqat egasi va administrator.
    // examAssign — yuborilgan nusxa (to'g'ri javobsiz), examKeys — shu nusxaning javob kaliti (faqat xodim).
    // examAttempts — o'quvchi urinishi: boshlanish vaqti server vaqti (request.time), muddatdan keyin javob qabul qilinmaydi.
    // examResults — baholash natijasi (o'qituvchi tomonida hisoblanadi), o'quvchi faqat o'zinikini o'qiydi.
    function ownerOrAdmin(d) { return isStaff() && (d.owner == request.auth.uid || isAdmin()); }
    function assignDoc(aid) { return get(/databases/$(db)/documents/examAssign/$(aid)).data; }
    match /examTests/{id} {
      allow read, delete: if ownerOrAdmin(resource.data);
      allow create: if isStaff() && request.resource.data.owner == request.auth.uid && request.resource.data.title is string;
      allow update: if ownerOrAdmin(resource.data) && request.resource.data.owner == resource.data.owner;
    }
    match /examAssign/{aid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid in resource.data.uids);
      allow create: if isStaff() && request.resource.data.owner == request.auth.uid
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 300
        && request.resource.data.dur is int && request.resource.data.dur >= 1 && request.resource.data.dur <= 300
        && request.resource.data.tries is int && request.resource.data.tries >= 1 && request.resource.data.tries <= 5
        && request.resource.data.start is timestamp && request.resource.data.end is timestamp
        && request.resource.data.end > request.resource.data.start;
      allow update: if ownerOrAdmin(resource.data) && request.resource.data.owner == resource.data.owner
        && request.resource.data.vars == resource.data.vars;
      allow delete: if ownerOrAdmin(resource.data);
    }
    match /examKeys/{aid} {
      allow read, delete: if ownerOrAdmin(resource.data);
      allow create: if isStaff() && request.resource.data.owner == request.auth.uid;
      allow update: if ownerOrAdmin(resource.data) && request.resource.data.keys == resource.data.keys;
    }
    match /examAttempts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['aid', 'uid', 'n', 'v', 'startedAt', 'ans', 'done', 'doneAt', 'saved'])
        && request.resource.data.n is int && request.resource.data.n >= 1
        && id == request.resource.data.aid + '_' + request.auth.uid + '_' + string(request.resource.data.n)
        && request.resource.data.startedAt == request.time && request.resource.data.saved == request.time
        && request.resource.data.done == false && request.resource.data.doneAt == null
        && request.resource.data.ans is map && request.resource.data.ans.size() == 0
        && request.auth.uid in assignDoc(request.resource.data.aid).uids
        && request.resource.data.n <= assignDoc(request.resource.data.aid).tries
        && request.resource.data.v == assignDoc(request.resource.data.aid).vmap.get(request.auth.uid, 0)
        && request.time >= assignDoc(request.resource.data.aid).start
        && request.time < assignDoc(request.resource.data.aid).end;
      // Javob saqlash/yakunlash: faqat o'zi, yakunlanmagan bo'lsa va vaqt tugamagan bo'lsa (20 s tarmoq zaxirasi)
      allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.done == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ans', 'done', 'doneAt', 'saved'])
        && request.resource.data.ans is map && request.resource.data.ans.size() <= 300
        && request.resource.data.saved == request.time
        && (request.resource.data.done == false || request.resource.data.doneAt == request.time)
        && request.time <= resource.data.startedAt + duration.value(assignDoc(resource.data.aid).dur * 60 + 20, 's')
        && request.time <= assignDoc(resource.data.aid).end + duration.value(20, 's');
      // Qayta ishlashga ruxsat: urinishni faqat testni yuborgan o'qituvchi (yoki admin) o'chiradi
      allow delete: if ownerOrAdmin(assignDoc(resource.data.aid));
    }
    // Natijani faqat testni yuborgan o'qituvchi (yoki admin) brauzeri yozadi; id = urinish id
    match /examResults/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create, update: if request.resource.data.aid is string && request.resource.data.uid is string
        && ownerOrAdmin(assignDoc(request.resource.data.aid))
        && id.matches('^' + request.resource.data.aid + '_' + request.resource.data.uid + '_[0-9]+$');
      allow delete: if ownerOrAdmin(assignDoc(resource.data.aid));
    }

    match /{document=**} { allow read, write: if false; }
  }
}
